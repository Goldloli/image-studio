{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Image Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "center": true,
        "backgroundColor": "#f5f5f5"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Image Studio",
    "shortDescription": "Local image creation workspace",
    "longDescription": "Internal Windows preview of the local Image Studio workspace.",
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/inference-supervisor",
      "binaries/diagnostic-worker",
      "binaries/realesrgan-worker"
    ],
    "useLocalToolsDir": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "minimumWebview2Version": "156.0.4314.58",
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
